#Functions
def display_data(data_string):
    text_area.config(state=tk.NORMAL)
    text_area.delete('1.0', tk.END)
    text_area.insert(tk.END, data_string)
    text_area.config(state=tk.DISABLED)

def show_schedule_gui():
    output = "🏁 2025 F1 Race Schedule 🏁\n\n"
    for race in race_schedule:
        output += f"R{race['round']}: {race['race']} ({race['location']}) - {race['date']}\n"
    display_data(output)

def show_driver_standings_gui():
    output = "👑 Driver Standings 👑\n\n"
    for driver in sorted(driver_standings, key=lambda x: x['pos']):
        output += f"{driver['pos']}. {driver['name']} ({driver['team']}) - {driver['points']} pts\n"
    display_data(output)

def show_constructor_standings_gui():
    output = "🏆 Team Standings 🏆\n\n"
    for team in sorted(show_constructor_standings_gui, key=lambda x: x['pos']):
        output += f"{team['pos']}. {team['name']} - {team['points']} pts\n"
    display_data(output)

